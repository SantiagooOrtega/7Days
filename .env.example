# Copia este archivo a backend/.env y rellena los valores. NUNCA subas .env al repositorio.

PORT=3000
NODE_ENV=development

# SQLite local (archivo). Para PostgreSQL: postgresql://user:pass@localhost:5432/sevendays
DATABASE_URL=file:./dev.db

# Secretos JWT: genera uno con `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Gemini (Google AI Studio). Solo se usa desde el backend.
GEMINI_API_KEY=
GEMINI_MODEL=
